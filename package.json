{
	"name": "flamework-templater",
	"type": "module",
	"scripts": {
		"prebuild": "bun scripts/generate-build-hash.ts",
		"build": "rbxtsc",
		"prewatch": "bun scripts/generate-build-hash.ts",
		"watch": "rbxtsc -w",
		"serve": "rojo serve --no-watch",
		"push": "rojo push",
		"format": "biome format --write .",
		"lint": "eslint . --fix; biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@eslint/js": "^10.0.1",
		"@rbxts/biome-plugin-roblox-ts": "^1.0.1",
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.944",
		"bun-types": "^1.3.14",
		"eslint": "^10.8.1",
		"eslint-plugin-roblox-ts": "^1.4.1",
		"rbxts-transformer-flamework": "^1.3.2",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3",
		"typescript-eslint": "^8.67.0"
	},
	"dependencies": {
		"@flamework/components": "^1.3.2",
		"@flamework/core": "^1.3.2",
		"@flamework/networking": "^1.3.2",
		"@rbxts/charm": "^0.11.0",
		"@rbxts/immut": "0.4.4-ts.0",
		"@rbxts/lapis": "^0.3.8",
		"@rbxts/maid": "^1.1.0",
		"@rbxts/object-utils": "^1.0.4",
		"@rbxts/roact": "^3.0.1",
		"@rbxts/roact-hooked": "^2.6.2",
		"@rbxts/services": "^1.6.0",
		"@rbxts/signal": "^1.1.1",
		"@rbxts/squash": "^3.0.0-ts.0",
		"@rbxts/t": "^3.2.1"
	}
}
